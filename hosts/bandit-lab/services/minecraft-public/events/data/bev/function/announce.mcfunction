# `say` reaches every player and the server log, where the dashboard reads it.
$execute if score #kind bev matches 1 run say Supply drop in $(minutes) min at X $(x) Z $(z)
$execute if score #kind bev matches 2 run say Something is waking at X $(x) Z $(z). $(minutes) min.
$execute if score #kind bev matches 3 run say The ground is shifting at X $(x) Z $(z). A ruin surfaces in $(minutes) min.
$execute if score #kind bev matches 4 run say A meteor will hit X $(x) Z $(z) in $(minutes) min
$execute if score #kind bev matches 5 run say A thunderstorm arrives in $(minutes) min
$execute if score #kind bev matches 6 run say A blood night falls in $(minutes) min
